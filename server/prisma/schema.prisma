// ============ XJTLU 校园闲置商城 ============

model MarketItem {
  id                       Int       @id @default(autoincrement())
  topicId                  Int?      @unique
  sellerId                 Int
  listingType              String    @default("sell") // sell / wanted
  title                    String
  description              String
  category                 String    @default("other")
  deliveryType             String    @default("physical") // physical / digital
  digitalDeliveryEncrypted String?
  priceCents               Int
  originalPriceCents       Int?
  negotiable               Boolean   @default(false)
  condition                String    @default("good")
  tradeMode                String    @default("meetup") // meetup / shipping / online / any
  campus                   String    @default("")
  location                 String    @default("")
  brand                    String    @default("")
  model                    String    @default("")
  usageDuration            String    @default("")
  flaws                    String    @default("")
  accessories              String    @default("")
  testAllowed              Boolean   @default(true)
  availableTime            String    @default("")
  contactVisibility        String    @default("after_accept")
  expiresAt                DateTime?
  renewedAt                DateTime?
  visibility               String    @default("public") // public / targeted
  sourceWantedPostId       Int?
  moderationNote           String    @default("")
  moderatedAt              DateTime?
  pinnedUntil              DateTime?
  pinnedPromotionOrderId   Int?      @unique
  homeFeaturedUntil        DateTime?
  homePromotionOrderId     Int?      @unique
  status                   String    @default("active") // draft / reviewing / active / reserved / sold / withdrawn / hidden
  viewCount                Int       @default(0)
  favoriteCount            Int       @default(0)
  offerCount               Int       @default(0)
  soldAt                   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  topic                Topic?                   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  seller               User                     @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  images               MarketImage[]
  favorites            MarketFavorite[]
  offers               MarketOffer[]
  orders               MarketOrder[]
  conversations        MarketConversation[]
  reports              MarketReport[]
  violations           MarketViolation[]
  learningMaterial     LearningMaterialProfile?
  tradeIntents         TradeIntent[]
  wantedResponses      WantedResponse[]
  sourceWantedPost     WantedPost?              @relation("WantedTargetedItems", fields: [sourceWantedPostId], references: [id], onDelete: SetNull)
  linkedTopics         Topic[]                  @relation("TopicLinkedMarketItem")
  promotionOrders      PromotionOrder[]         @relation("PromotionMarketItem")
  pinnedPromotionOrder PromotionOrder?          @relation("ActiveListingPin", fields: [pinnedPromotionOrderId], references: [id], onDelete: SetNull)
  homePromotionOrder   PromotionOrder?          @relation("ActiveHomeFeature", fields: [homePromotionOrderId], references: [id], onDelete: SetNull)
  matchNotices         MarketMatchNotice[]

  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@index([sellerId, status, updatedAt])
  @@index([listingType, status, createdAt])
  @@index([priceCents])
  @@index([status, priceCents])
  @@index([condition, status, createdAt])
  @@index([tradeMode, status, createdAt])
  @@index([campus, status, createdAt])
  @@index([expiresAt, status])
  @@index([sourceWantedPostId])
}

model MarketImage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  item MarketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sort])
}

model MarketFavorite {
  id        Int      @id @default(autoincrement())
  itemId    Int
  userId    Int
  createdAt DateTime @default(now())

  item MarketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, createdAt])
}

model MarketOffer {
  id         Int      @id @default(autoincrement())
  itemId     Int
  buyerId    Int
  priceCents Int
  message    String   @default("")
  status     String   @default("pending") // pending / accepted / rejected / cancelled / expired
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item  MarketItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer User         @relation("MarketOfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  order MarketOrder?

  @@index([itemId, status, createdAt])
  @@index([buyerId, status, createdAt])
}

model TradeIntent {
  id                 Int       @id @default(autoincrement())
  itemId             Int
  buyerId            Int
  proposedPriceCents Int
  message            String    @default("")
  availableTime      String    @default("")
  status             String    @default("pending") // pending / accepted / rejected / cancelled / expired
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  item        MarketItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer       User         @relation("TradeIntentBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  reservation MarketOrder?

  @@index([itemId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model WantedPost {
  id                     Int       @id @default(autoincrement())
  authorId               Int
  title                  String
  category               String    @default("other")
  budgetMinCents         Int
  budgetMaxCents         Int
  brandModel             String    @default("")
  condition              String    @default("")
  expectedTradeTime      String    @default("")
  campus                 String    @default("")
  location               String    @default("")
  description            String
  allowSellerOffers      Boolean   @default(true)
  isAnonymous            Boolean   @default(false)
  anonymousAlias         String?
  status                 String    @default("active") // reviewing / active / responded / matched / completed / cancelled / expired / removed
  expiresAt              DateTime
  moderationNote         String    @default("")
  moderatedAt            DateTime?
  urgentUntil            DateTime?
  urgentPromotionOrderId Int?      @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  author               User                @relation("WantedPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responses            WantedResponse[]
  targetedItems        MarketItem[]        @relation("WantedTargetedItems")
  reservations         MarketOrder[]
  reports              MarketReport[]
  violations           MarketViolation[]
  linkedTopics         Topic[]             @relation("TopicLinkedWantedPost")
  promotionOrders      PromotionOrder[]    @relation("PromotionWantedPost")
  urgentPromotionOrder PromotionOrder?     @relation("ActiveWantedUrgent", fields: [urgentPromotionOrderId], references: [id], onDelete: SetNull)
  matchNotices         MarketMatchNotice[]

  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@index([authorId, status, updatedAt])
  @@index([expiresAt, status])
}

model WantedResponse {
  id            Int      @id @default(autoincrement())
  wantedPostId  Int
  sellerId      Int
  itemId        Int
  priceCents    Int
  description   String   @default("")
  availableTime String   @default("")
  status        String   @default("pending") // pending / accepted / rejected / cancelled / expired
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wantedPost  WantedPost   @relation(fields: [wantedPostId], references: [id], onDelete: Cascade)
  seller      User         @relation("WantedResponseSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  item        MarketItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  reservation MarketOrder?

  @@index([wantedPostId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([createdAt])
}

model MarketOrder {
  id                       Int       @id @default(autoincrement())
  itemId                   Int
  offerId                  Int?      @unique
  tradeIntentId            Int?      @unique
  wantedPostId             Int?
  wantedResponseId         Int?      @unique
  buyerId                  Int
  sellerId                 Int
  outTradeNo               String    @unique
  tradeNo                  String?
  payType                  String    @default("")
  amountCents              Int
  platformFeeCents         Int       @default(0)
  sellerAmountCents        Int
  deliveryType             String    @default("physical") // order-time fulfillment snapshot
  digitalDeliveryEncrypted String?
  digitalDeliveredAt       DateTime?
  status                   String    @default("pending_payment") // pending_payment / paid / delivering / completed / cancelled / refund_pending / refunded / disputed
  meetupTime               DateTime?
  meetupLocation           String    @default("")
  meetupReminderSentAt     DateTime?
  note                     String    @default("")
  cancelReason             String    @default("")
  cancelledById            Int?
  noShowParty              String    @default("") // buyer / seller
  buyerConfirmedAt         DateTime?
  sellerConfirmedAt        DateTime?
  expiresAt                DateTime?
  paidAt                   DateTime?
  completedAt              DateTime?
  closedAt                 DateTime?
  refundedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  item                    MarketItem                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  offer                   MarketOffer?                   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  tradeIntent             TradeIntent?                   @relation(fields: [tradeIntentId], references: [id], onDelete: Restrict)
  wantedPost              WantedPost?                    @relation(fields: [wantedPostId], references: [id], onDelete: SetNull)
  wantedResponse          WantedResponse?                @relation(fields: [wantedResponseId], references: [id], onDelete: Restrict)
  buyer                   User                           @relation("MarketOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller                  User                           @relation("MarketOrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  cancelledBy             User?                          @relation("MarketOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  conversation            MarketConversation?
  paymentLogs             MarketPaymentLog[]
  refunds                 MarketRefund[]
  settlement              MarketSettlement?
  reviews                 MarketReview[]
  reports                 MarketReport[]
  violations              MarketViolation[]
  learningMaterialAccess  LearningMaterialAccess?
  learningMaterialSupport LearningMaterialSupportTicket?
  learningCommerceOrder   LearningCommerceOrder?

  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, expiresAt])
  @@index([itemId, createdAt])
  @@index([wantedPostId, status, createdAt])
  @@index([cancelledById])
  @@index([status, meetupTime])
}

model MarketConversation {
  id            Int       @id @default(autoincrement())
  itemId        Int
  orderId       Int?      @unique
  buyerId       Int
  sellerId      Int
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  item     MarketItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order    MarketOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  buyer    User            @relation("MarketConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User            @relation("MarketConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages MarketMessage[]

  @@unique([itemId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model MarketMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation MarketConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation("MarketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MarketReview {
  id           Int      @id @default(autoincrement())
  orderId      Int
  authorId     Int
  targetUserId Int
  rating       Int
  content      String   @default("")
  createdAt    DateTime @default(now())

  order      MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User        @relation("MarketReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser User        @relation("MarketReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, authorId])
  @@index([targetUserId, createdAt])
}

model MarketReport {
  id             Int       @id @default(autoincrement())
  itemId         Int?
  wantedPostId   Int?
  orderId        Int?
  reportedUserId Int?
  reporterId     Int
  type           String    @default("listing") // listing / wanted / user / trade
  reason         String
  detail         String    @default("")
  status         String    @default("pending") // pending / resolved / rejected
  handledById    Int?
  handledNote    String    @default("")
  handledAt      DateTime?
  createdAt      DateTime  @default(now())

  item         MarketItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  wantedPost   WantedPost?  @relation(fields: [wantedPostId], references: [id], onDelete: Cascade)
  order        MarketOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedUser User?        @relation("MarketReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter     User         @relation("MarketReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([itemId, reporterId])
  @@index([status, createdAt])
  @@index([wantedPostId, reporterId])
  @@index([orderId, reporterId])
  @@index([reportedUserId, reporterId])
}

model MarketContactCard {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  method         String
  valueEncrypted String
  valueMasked    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
