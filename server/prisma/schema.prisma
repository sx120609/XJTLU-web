  handledReason   String                        @default("")
  handledAt       DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  commerceOrder LearningCommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  asset         LearningPrivateAsset  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  submittedBy   User                  @relation("LearningPaymentEvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  handledBy     User?                 @relation("LearningPaymentEvidenceHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([commerceOrderId, attempt])
  @@index([commerceOrderId, status, createdAt])
  @@index([submittedById, createdAt])
  @@index([handledById, handledAt])
}

model LearningOrderEvent {
  id              Int                          @id @default(autoincrement())
  commerceOrderId Int
  sequence        Int
  type            String
  actorId         Int?
  fromStatus      LearningCommerceOrderStatus?
  toStatus        LearningCommerceOrderStatus?
  requestId       String                       @default("")
  detail          String                       @default("{}")
  createdAt       DateTime                     @default(now())

  commerceOrder LearningCommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  actor         User?                 @relation("LearningOrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([commerceOrderId, sequence])
  @@index([commerceOrderId, createdAt])
  @@index([type, createdAt])
  @@index([actorId, createdAt])
}

model LearningOrderIssue {
  id                Int                      @id @default(autoincrement())
  commerceOrderId   Int
  requestedById     Int
  type              String
  status            LearningOrderIssueStatus @default(open)
  reason            String
  detail            String                   @default("")
  refundAmountCents Int?
  refundAssetId     Int?                     @unique
  resolvedById      Int?
  resolution        String                   @default("")
  resolvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  commerceOrder LearningCommerceOrder @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  requestedBy   User                  @relation("LearningOrderIssueRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  refundAsset   LearningPrivateAsset? @relation("LearningIssueRefundAsset", fields: [refundAssetId], references: [id], onDelete: Restrict)
  resolvedBy    User?                 @relation("LearningOrderIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([commerceOrderId, status, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([resolvedById, resolvedAt])
}

model LearningCommerceCommand {
  id             Int                           @id @default(autoincrement())
  actorId        Int
  operation      String
  idempotencyKey String
  requestHash    String
  status         LearningCommerceCommandStatus @default(processing)
  resourceType   String                        @default("")
  resourceId     String                        @default("")
  responseCode   Int?
  responseBody   String                        @default("")
  expiresAt      DateTime
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  actor User @relation("LearningCommerceCommandActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, idempotencyKey])
  @@index([status, expiresAt])
  @@index([resourceType, resourceId, createdAt])
}

// ============ 通知与待办（保留，但语义改为论坛事件） ============

model Notification {
  id           Int       @id @default(autoincrement())
  userId       Int? // null = 全局广播
  // 事件类型：reply / mention / like / system / school-feed
  category     String
  // 目标客户端：null = 全部；仅对对应客户端可见
  targetClient String?
  level        String    @default("normal") // strong / normal / weak
  title        String
  content      String
  payload      String    @default("{}")
  link         String? // 站内路由
  source       String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads NotificationRead[]

  @@index([userId, readAt])
  @@index([userId, category, createdAt])
  @@index([category, createdAt])
  @@index([targetClient, createdAt])
}

model NotificationRead {
  id             Int      @id @default(autoincrement())
  userId         Int
  notificationId Int
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, readAt])
}

model MessageSetting {
  id                 Int     @id @default(autoincrement())
  userId             Int     @unique
  quietStart         String  @default("23:00")
  quietEnd           String  @default("07:00")
  qqBotNotifyEnabled Boolean @default(true)
  subscribeReply     Boolean @default(true)
  subscribeLike      Boolean @default(true)
  subscribeSchool    Boolean @default(true)
  subscribeSystem    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ QQBot / NapCat 对接 ============

model QqBotConfig {
  id                  Int      @id @default(autoincrement())
  enabled             Boolean  @default(false)
  botQqId             String   @default("")
  napcatBaseUrl       String   @default("")
  accessToken         String   @default("")
  webhookSecret       String   @default("")
  defaultBoardSlug    String   @default("general")
  allowPrivatePost    Boolean  @default(true)
  allowGroupPost      Boolean  @default(false)
  notificationEnabled Boolean  @default(true)
  notifyCategories    String   @default("[\"reply\",\"mention\",\"like\",\"system\",\"service-tool\",\"school-feed\"]")
  superAdminQqIds     String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model QqBotBinding {
  id        Int      @id @default(autoincrement())
  userId    Int
  qqId      String   @unique
  nickname  String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

model QqBotBindToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model QqBotGroup {
  id                   Int      @id @default(autoincrement())
  groupId              String   @unique
  name                 String?
  enabled              Boolean  @default(true)
  allowPosting         Boolean  @default(false)
  defaultBoardSlug     String?
  notificationEnabled  Boolean  @default(true)
  notifyCategories     String   @default("[\"system\",\"school-feed\"]")
  notifyAudiences      String   @default("[\"public\"]")
  memberWelcomeEnabled Boolean  @default(false)
  memberWelcomeMessage String   @default("欢迎加入本群，请先查看群公告了解群内规则和使用说明。\n\n如果想把课表添加到手机桌面，可以先打开站内课表页，再按页面提示完成添加。\n\n也欢迎前往个人中心绑定本 QQBot，绑定后可在 QQ 同步接收站内通知。建议顺手把本 QQBot 添加为好友，消息接收和后续操作体验会更顺畅。后续还会陆续接入更多实用功能，敬请期待。")
  adFilterEnabled      Boolean  @default(false)
  joinReviewEnabled    Boolean  @default(false)
  allowMute            Boolean  @default(false)
  allowKick            Boolean  @default(false)
  allowKickAndBlock    Boolean  @default(false)
  commandUserQqIds     String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([enabled])
}

model QqBotGroupJoinRequest {
  id            Int       @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  comment       String?
  flag          String    @unique
  status        String    @default("pending") // pending / approved / rejected / expired
  handledAction String?
  handledByQqId String?
  rawPayload    String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  handledAt     DateTime?

  @@index([groupId, status, createdAt])
  @@index([qqId, status, createdAt])
}

model QqBotGroupBlockedUser {
  id            Int      @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  blockedByQqId String?
  source        String   @default("manual") // manual / command / join-request
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, qqId])
  @@index([groupId, createdAt])
  @@index([qqId, createdAt])
}

model QqBotGroupAdStrike {
  id            Int      @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  hitCount      Int      @default(0)
  lastReason    String?
  lastRiskScore Int?
  lastModel     String?
  lastHitAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, qqId])
  @@index([groupId, lastHitAt])
  @@index([qqId, lastHitAt])
}

model QqBotMessageLog {
  id             Int      @id @default(autoincrement())
  direction      String // inbound / outbound
  eventType      String
  status         String   @default("ok") // ok / ignored / error
  qqId           String?
  groupId        String?
  messageId      String?
  userId         Int?
  topicId        Int?
  notificationId Int?
  command        String?
  content        String   @default("")
  result         String   @default("")
  rawPayload     String   @default("{}")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([qqId, createdAt])
  @@index([userId, createdAt])
  @@index([notificationId, userId])
}

model QqBotConversation {
  id              Int      @id @default(autoincrement())
  qqId            String
  groupId         String?
  scene           String
  status          String   @default("active")
  step            String
  draftTitle      String?
  draftContent    String   @default("")
  draftBoardSlug  String?
  sourceMessageId String?
  sourceSummary   String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([qqId, status, updatedAt])
  @@index([groupId, status, updatedAt])
}

// ============ 站点功能开关 ============
// KV 风格存储。当前用法：
//   feature.forum         = 'on' | 'off'  控制论坛通用板块（包括 /forum 入口、发帖）
//   feature.market        = 'on' | 'off'  控制二手市场
//   feature.coursereview  = 'on' | 'off'  控制课程点评
// 出于"言论敏感时一键下架"的考虑，admin 可在管理后台随时切换。
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ 刷课工具：AI 答题额度与消耗 ============
// 视频刷课免费（拉人气），仅 AI 答题计费。
//   CourseBotQuota: 每用户一行，存 AI 答题余额与累计统计
//   CourseBotUsageLog: 每次答题消耗流水，同时作为"错题沉淀"库（questionHash 去重）

model CourseBotQuota {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  aiBalance     Int      @default(0) // AI 答题剩余额度（题数）
  totalConsumed Int      @default(0) // 累计消耗
  totalGranted  Int      @default(0) // 累计获得（admin 发放 + 购买）
  note          String? // 备注（admin 发放时填写）
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiBalance])
}

model CourseBotUsageLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  questionHash String // 题干归一化指纹，用于错题沉淀与命中去重
  questionText String // 题干快照（截断存储）
  aiAnswer     String // AI 给出的答案
  correct      Boolean? // 是否答对：null=未知/填空待确认，true/false=已知
  cost         Int      @default(1) // 本次消耗额度
  model        String? // 使用的 AI 模型
  platform     String   @default("chaoxing") // chaoxing / zhihuiredao
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionHash])
  @@index([userId, questionHash])
}

model AdminDailyLogin {
  id           Int      @id @default(autoincrement())
  userId       Int
  dateKey      String
  client       String?
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@index([dateKey, userId])
  @@index([userId, lastLoginAt])
}
