model PromotionOrder {
  id                    Int       @id @default(autoincrement())
  userId                Int
  planId                Int
  marketItemId          Int?
  wantedPostId          Int?
  merchantProfileId     Int?
  outTradeNo            String    @unique
  planCode              String
  planName              String
  type                  String
  targetType            String
  placement             String
  amountCents           Int
  manualCostCents       Int       @default(0)
  durationDays          Int
  paymentMode           String    @default("manual")
  status                String    @default("pending") // waitlisted / pending / confirmed / rejected / cancelled / expired
  paymentCode           String    @default("") @db.VarChar(4)
  paymentSubmittedAt    DateTime?
  paymentExpiresAt      DateTime?
  reservesSlot          Boolean   @default(true)
  waitlistedAt          DateTime?
  slotNotifiedAt        DateTime?
  applicantNote         String    @default("")
  adminNote             String    @default("")
  verificationMethod    String    @default("")
  verificationReference String    @default("")
  verifiedAmountCents   Int?
  reviewedById          Int?
  reviewedAt            DateTime?
  startsAt              DateTime?
  expiresAt             DateTime?
  confirmedAt           DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  impressionCount       Int       @default(0)
  clickCount            Int       @default(0)
  inquiryStartCount     Int       @default(0)
  inquiryEndCount       Int?
  renewalReminderSentAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                   User                  @relation("PromotionOrderApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                 @relation("PromotionOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  plan                   PromotionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  marketItem             MarketItem?           @relation("PromotionMarketItem", fields: [marketItemId], references: [id], onDelete: SetNull)
  wantedPost             WantedPost?           @relation("PromotionWantedPost", fields: [wantedPostId], references: [id], onDelete: SetNull)
  merchantProfile        MerchantProfile?      @relation("PromotionMerchantProfile", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  activeListingPin       MarketItem?           @relation("ActiveListingPin")
  activeHomeFeature      MarketItem?           @relation("ActiveHomeFeature")
  activeWantedUrgent     WantedPost?           @relation("ActiveWantedUrgent")
  activeMerchantHomepage MerchantProfile?      @relation("ActiveMerchantHomepage")
  events                 PromotionEvent[]
  adjustments            PromotionAdjustment[]

  @@index([userId, status, createdAt])
  @@index([paymentMode, status, createdAt])
  @@index([paymentMode, confirmedAt])
  @@index([type, status, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([status, expiresAt])
  @@index([type, status, startsAt, expiresAt])
  @@index([marketItemId, status])
  @@index([wantedPostId, status])
  @@index([merchantProfileId, status])
}

model PromotionAdjustment {
  id            Int      @id @default(autoincrement())
