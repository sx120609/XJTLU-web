  targetType      String // market_item / wanted_post / merchant_profile
  placement       String // market / wanted / home / merchant
  description     String   @default("")
  priceCents      Int
  manualCostCents Int      @default(0)
  durationDays    Int
  maxActive       Int      @default(0)
  enabled         Boolean  @default(true)
