PORT=3011
NODE_ENV=development
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/xjtlu_web?schema=public"
JWT_SECRET="xjtlu-web-dev-secret-please-change-in-production"
JWT_EXPIRES_IN="7d"
# 未勾选“保持登录”时的空闲会话时长；勾选后使用绝对时长
BROWSER_SESSION_IDLE_MS=1800000
BROWSER_SESSION_ABSOLUTE_MS=31536000000
# eHall / eBridge 加密会话的滑动保存时长；学校上游 Cookie 自身失效后仍需重新认证
XJTLU_PORTAL_SESSION_IDLE_MS=31536000000
# 跨域部署时显式填写允许的前端 Origin，多个值用逗号分隔
CORS_ALLOWED_ORIGINS=""
# Node 直连公网保持 0；前面恰好有一层可信反向代理时设为 1
TRUST_PROXY_HOPS=0
REDIS_ENABLED=false
REDIS_URL=""
REDIS_PREFIX="xjtlu-web"
# 集成测试默认拒绝远程数据库；仅隔离的 CI 数据库可显式开启
ALLOW_REMOTE_INTEGRATION_DB=false
# 校园网可能有大量用户共享 NAT 出口；以下值可按部署规模调整
XJTLU_SSO_BEGIN_GLOBAL_LIMIT=3000
XJTLU_SSO_SUBMIT_GLOBAL_LIMIT=1500
XJTLU_SSO_BEGIN_IP_LIMIT=600
XJTLU_SSO_SUBMIT_IP_LIMIT=300
XJTLU_SSO_SUBMIT_ACCOUNT_LIMIT=8
# ANDROID_APP_DOWNLOAD_URL=https://download.lizmt.cn/Android/CPU-Web-Android-V4.apk

# 宿舍电费代理地址
# DORM_ELECTRIC_BASE=http://sz.weicheng.wang:8899

# ============ Filestore ============
# FILESTORE_ENABLED=true
# FILESTORE_PORT=8975
# FILESTORE_PYTHON=python3
# FILESTORE_ADMIN_PASSWORD=admin123

# ============ Paid learning materials ============
# Production must explicitly opt in after migration and private-storage checks pass.
PAID_LEARNING_MATERIALS_ENABLED=false
# Price limits are integer cents (100 = CNY 1.00).
LEARNING_MATERIAL_MIN_PRICE_CENTS=100
LEARNING_MATERIAL_MAX_PRICE_CENTS=100000
# Lifecycle windows are milliseconds: payment 24h, seller confirmation 24h, auto-completion 72h.
LEARNING_PAYMENT_DUE_MS=86400000
LEARNING_SELLER_CONFIRM_DUE_MS=86400000
LEARNING_COMPLETION_DUE_MS=259200000
